@@ -0,0 +1,32 @@
+#!/usr/bin/env bash
+#SBATCH --job-name=usst-hot3d-train
+#SBATCH --account=l.torresani
+#SBATCH --partition=torresani-lab
+#SBATCH --nodes=1
+#SBATCH --ntasks=1
+#SBATCH --cpus-per-task=8
+#SBATCH --mem=128G
+#SBATCH --gres=gpu:h200:1
+#SBATCH --time=1-00:00:00
+#SBATCH --output=/home/jun.se/EGO-HAND-WM-REF/USST/logs/%x-%j.out
+#SBATCH --error=/home/jun.se/EGO-HAND-WM-REF/USST/logs/%x-%j.err
+
+set -euo pipefail
+
+REPO=/home/jun.se/EGO-HAND-WM-REF/USST
+PYTHON=/projects/torresani-lab/sejoon/miniconda3/envs/usst-h6k16/bin/python
+CONFIG=config/adapted/hot3d_clips_h6_k16_res18_3d_absolute.yml
+TAG=${TAG_OVERRIDE:-paper-hot3d-h6k16-absolute-seed0}
+SNAPSHOT=/projects/torresani-lab/sejoon/runs/baselines/USST/HOT3DClips/${TAG}/snapshot/last.pth
+
+cd "$REPO"
+args=(
+  --config "$CONFIG"
+  --tag "$TAG"
+  --num_workers 8
+  --epochs 40
+)
+if [[ "${NO_RESUME:-0}" != 1 && -s "$SNAPSHOT" ]]; then
+  args+=(--resume "$SNAPSHOT")
+fi
+exec "$PYTHON" -u train.py "${args[@]}"
