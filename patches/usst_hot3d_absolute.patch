@@ -0,0 +1,193 @@
+"""Absolute-XYZ H6/K16 manifest loader for controlled HOT3D-Clips runs."""
+
+from __future__ import annotations
+
+import json
+import multiprocessing
+import os
+import sys
+from pathlib import Path
+
+import numpy as np
+import torch
+from torch.utils.data import DataLoader, Dataset
+
+
+EGO_HAND_WM_SRC = Path(
+    os.environ.get("EGO_HAND_WM_SRC", "/home/jun.se/EGO-HAND-WM/src")
+)
+if str(EGO_HAND_WM_SRC) not in sys.path:
+    sys.path.insert(0, str(EGO_HAND_WM_SRC))
+
+from ego_hand_wm.contracts.schema import SCHEMA
+from ego_hand_wm.data.adapters.hot3d_clips import canonicalize_hot3d_clip_window
+from ego_hand_wm.geometry.se3 import pose9_to_matrix
+
+
+HISTORY_STEPS = 6
+FUTURE_STEPS = 16
+TOTAL_STEPS = HISTORY_STEPS + FUTURE_STEPS
+
+
+def standardize_xyz(trajectory, mean, std):
+    value = np.asarray(trajectory, dtype=np.float32)
+    return (
+        (value - np.asarray(mean, dtype=np.float32))
+        / np.asarray(std, dtype=np.float32)
+    ).astype(np.float32)
+
+
+def metric_xyz(trajectory, mean, std):
+    value = np.asarray(trajectory, dtype=np.float32)
+    return (
+        value * np.asarray(std, dtype=np.float32)
+        + np.asarray(mean, dtype=np.float32)
+    ).astype(np.float32)
+
+
+class H6K16ManifestDataset(Dataset):
+    """Read public HOT3D tar windows as absolute anchor-camera XYZ targets."""
+
+    def __init__(
+        self,
+        manifest,
+        *,
+        input_size,
+        means,
+        stds,
+        xyz_mean,
+        xyz_std,
+        camera_stream="214-1",
+    ):
+        self.manifest = Path(manifest)
+        self.records = [
+            json.loads(line)
+            for line in self.manifest.read_text(encoding="utf-8").splitlines()
+            if line.strip()
+        ]
+        if not self.records:
+            raise ValueError(f"Empty H6/K16 manifest: {self.manifest}")
+        self.input_size = int(input_size)
+        self.means = torch.tensor(means, dtype=torch.float32).view(1, 3, 1, 1)
+        self.stds = torch.tensor(stds, dtype=torch.float32).view(1, 3, 1, 1)
+        self.xyz_mean = tuple(float(value) for value in xyz_mean)
+        self.xyz_std = tuple(float(value) for value in xyz_std)
+        self.camera_stream = str(camera_stream)
+        for record in self.records:
+            if record.get("dataset") != "hot3d_clips_aria":
+                raise ValueError(
+                    f"HOT3D manifest loader received {record.get('dataset')!r}"
+                )
+            if record.get("protocol") != "h6_k16_30hz":
+                raise ValueError(f"Unsupported protocol: {record.get('sample_id')}")
+
+    def __len__(self):
+        return len(self.records)
+
+    def __getitem__(self, index):
+        record = self.records[index]
+        sample = canonicalize_hot3d_clip_window(
+            record["tar_path"],
+            record["history_indices"],
+            record["future_indices"],
+            record["history_time_seconds"],
+            record["future_time_seconds"],
+            tracked_hand=record["tracked_hand"],
+            camera_stream=str(record.get("camera_stream", self.camera_stream)),
+            anchor="last_observed",
+            wrist_target="xyz",
+            decode_rgb=True,
+            image_size=self.input_size,
+            rotate_clockwise=True,
+        )
+        state = torch.cat((sample["history_state"], sample["future_state"]), dim=0)
+        wrist_slice = (
+            SCHEMA.left_wrist
+            if record["tracked_hand"] == "left"
+            else SCHEMA.right_wrist
+        )
+        trajectory_metric = (
+            state[:, wrist_slice.start : wrist_slice.start + 3]
+            .cpu()
+            .numpy()
+            .astype(np.float32)
+        )
+        trajectory_model = standardize_xyz(
+            trajectory_metric, self.xyz_mean, self.xyz_std
+        )
+        camera = pose9_to_matrix(state[:, SCHEMA.camera]).float()
+
+        observed_images = sample["context_images"].float()
+        observed_images = (observed_images - self.means) / self.stds
+        clip = torch.zeros(
+            3,
+            TOTAL_STEPS,
+            self.input_size,
+            self.input_size,
+            dtype=torch.float32,
+        )
+        clip[:, :HISTORY_STEPS] = observed_images.permute(1, 0, 2, 3)
+        return (
+            str(record["sample_id"]),
+            clip,
+            camera,
+            torch.tensor(TOTAL_STEPS, dtype=torch.long),
+            torch.from_numpy(trajectory_model),
+        )
+
+
+def _loader(dataset, *, batch_size, shuffle, num_workers):
+    options = {
+        "dataset": dataset,
+        "batch_size": int(batch_size),
+        "shuffle": bool(shuffle),
+        "num_workers": int(num_workers),
+        "pin_memory": True,
+    }
+    if num_workers > 0:
+        options.update(
+            multiprocessing_context="spawn",
+            persistent_workers=True,
+            prefetch_factor=2,
+        )
+    return DataLoader(**options)
+
+
+def build_dataloaders(cfg, phase="trainval"):
+    def dataset(split):
+        return H6K16ManifestDataset(
+            cfg.DATA.manifests[split],
+            input_size=int(cfg.DATA.transform.input_size[0]),
+            means=tuple(cfg.DATA.transform.means),
+            stds=tuple(cfg.DATA.transform.stds),
+            xyz_mean=tuple(cfg.MODEL.xyz_mean),
+            xyz_std=tuple(cfg.MODEL.xyz_std),
+            camera_stream=str(getattr(cfg.DATA, "camera_stream", "214-1")),
+        )
+
+    if phase == "trainval":
+        trainset = dataset("train")
+        valset = dataset("validation")
+        print(f"Number of train/val: {len(trainset)}/{len(valset)}")
+        return (
+            _loader(
+                trainset,
+                batch_size=cfg.TRAIN.batch_size,
+                shuffle=True,
+                num_workers=cfg.num_workers,
+            ),
+            _loader(
+                valset,
+                batch_size=cfg.TEST.batch_size,
+                shuffle=False,
+                num_workers=cfg.num_workers,
+            ),
+        )
+    testset = dataset("test")
+    print(f"Number of test samples: {len(testset)}")
+    return _loader(
+        testset,
+        batch_size=cfg.TEST.batch_size,
+        shuffle=False,
+        num_workers=cfg.num_workers,
+    )
