+#!/usr/bin/env python3
+"""Evaluate absolute-output USST on controlled public HOT3D-Clips."""
+
+from __future__ import annotations
+
+import importlib
+import json
+from pathlib import Path
+
+import numpy as np
+import torch
+
+from src.H6K16ManifestLoader import build_dataloaders
+from src.config import parse_configs
+from src.runtime import run_test
+from src.utils import compute_block_distances, compute_displacement_errors, set_deterministic
+from src.utils_io import load_checkpoint, print_de_table, print_delta_table
+
+
+def main():
+    cfg = parse_configs(phase="test")
+    if str(cfg.DATA.dataset) != "HOT3DClips":
+        raise ValueError("test_hot3d.py requires DATA.dataset=HOT3DClips")
+    set_deterministic(cfg.seed)
+    loader = build_dataloaders(cfg, phase="test")
+    model_module = importlib.import_module(f"src.models.{cfg.MODEL.arch}")
+    model = getattr(model_module, cfg.MODEL.arch)(
+        cfg.MODEL,
+        seq_len=cfg.DATA.max_frames,
+        input_size=cfg.DATA.transform.input_size[0],
+    ).to(cfg.device)
+    model, test_epoch = load_checkpoint(cfg, model)
+    model.eval()
+
+    result_path = (
+        Path(cfg.output_dir) / cfg.DATA.dataset / cfg.tag / f"test-e{test_epoch}"
+    )
+    result_path.mkdir(parents=True, exist_ok=True)
+    result_file = result_path / "test_results.npz"
+    if result_file.exists():
+        payload = np.load(result_file, allow_pickle=True)
+        predictions, targets = payload["pred"][()], payload["gt"][()]
+    else:
+        with torch.no_grad():
+            predictions, targets = run_test(cfg, model, loader)
+        np.savez(result_file, pred=predictions, gt=targets)
+
+    ades, fdes = compute_displacement_errors(
+        predictions, targets, target=model.target, eval_space="3d"
+    )
+    dxs, dys, dzs = compute_block_distances(
+        predictions, targets, target=model.target, eval_space="3d"
+    )
+    metrics = {
+        "ade_3d_m": float(np.mean(list(ades.values()))),
+        "fde_3d_m": float(np.mean(list(fdes.values()))),
+        "evaluated_examples": int(
+            sum(len(value) for value in predictions.values())
+        ),
+        "output_parameterization": "absolute_xyz",
+        "official_hidden_test": False,
+    }
+    print_de_table(ades, fdes, subset="Controlled test")
+    print_delta_table(dxs, dys, dzs, subset="Controlled test")
+    (result_path / "paired_metrics.json").write_text(
+        json.dumps(metrics, indent=2, sort_keys=True) + "\n",
+        encoding="utf-8",
+    )
+    print(json.dumps(metrics, indent=2, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
