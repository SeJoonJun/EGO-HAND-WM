@@ -0,0 +1,46 @@
+from pathlib import Path
+
+import numpy as np
+
+from src.H6K16ManifestLoader import H6K16ManifestDataset, metric_xyz, standardize_xyz
+
+
+MEAN = (0.2704353097511446, -0.06219469197952073, 0.3184789241289701)
+STD = (0.11184064967022754, 0.1866135967844919, 0.10673271771077786)
+
+
+def test_hot3d_xyz_standardization_is_absolute_and_reversible():
+    xyz = np.asarray(
+        [[0.2, -0.1, 0.3], [0.4, 0.2, 0.5], [-0.2, -0.4, 0.1]],
+        dtype=np.float32,
+    )
+    np.testing.assert_allclose(
+        metric_xyz(standardize_xyz(xyz, MEAN, STD), MEAN, STD),
+        xyz,
+        rtol=1e-6,
+        atol=1e-6,
+    )
+
+
+def test_real_hot3d_window_decodes_absolute_xyz_and_rgb():
+    manifest = Path(
+        "/home/jun.se/EGO-HAND-WM/data/hot3d_clips_h6_k16/"
+        "hot3d_clips_aria_train_h6_k16.jsonl"
+    )
+    if not manifest.exists():
+        return
+    dataset = H6K16ManifestDataset(
+        manifest,
+        input_size=64,
+        means=(0.5, 0.5, 0.5),
+        stds=(0.5, 0.5, 0.5),
+        xyz_mean=MEAN,
+        xyz_std=STD,
+    )
+    sample_id, clip, camera, nframes, trajectory = dataset[0]
+    assert sample_id.startswith("hot3d:")
+    assert tuple(clip.shape) == (3, 22, 64, 64)
+    assert tuple(camera.shape) == (22, 4, 4)
+    assert int(nframes) == 22
+    assert tuple(trajectory.shape) == (22, 3)
+    assert np.isfinite(trajectory.numpy()).all()
