+        latent_dim=32,
+        diffusion_steps=10,
+        timestep_respacing="2",
+        validation_timestep_respacing="2",
+        hand_layers=1,
+        egomotion_layers=1,
+        vision_model="tiny_cnn",
+        coordinate_contract="anchor_xyz_train_standardized_absolute_v3",
+        residual_to_last_observation=False,
+        zero_initialize_residual=False,
+    )
+    model = EgoMANStyleMMTwin(config)
+    final_layer = model.trajectory_decoder.feat_embed[-1]
+    assert torch.count_nonzero(final_layer.weight).item() > 0
