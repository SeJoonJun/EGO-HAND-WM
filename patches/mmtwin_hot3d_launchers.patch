+#!/usr/bin/env bash
+#SBATCH --job-name=mmtwin-hot3d-eval
+#SBATCH --account=l.torresani
+#SBATCH --partition=torresani-lab
+#SBATCH --nodes=1
+#SBATCH --ntasks=1
