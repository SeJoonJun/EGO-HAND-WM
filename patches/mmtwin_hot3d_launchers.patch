+#SBATCH --mem=192G
+#SBATCH --gres=gpu:h200:1
+#SBATCH --time=08:00:00
+#SBATCH --output=/home/jun.se/EGO-HAND-WM-REF/MMTwin/logs/%x-%j.out
+#SBATCH --error=/home/jun.se/EGO-HAND-WM-REF/MMTwin/logs/%x-%j.err
+
+set -euo pipefail
+
+REPO=/home/jun.se/EGO-HAND-WM-REF/MMTwin
+PYTHON=/projects/torresani-lab/sejoon/miniconda3/envs/mmtwin-h6k16/bin/python
+MANIFESTS=/home/jun.se/EGO-HAND-WM/data/hot3d_clips_h6_k16
+OUTPUT=/projects/torresani-lab/sejoon/runs/baselines/MMTwin/hot3d-h6k16-absolute-seed0
+BEST="$OUTPUT/best.pt"
+METRICS="$OUTPUT/metrics-test-n1.json"
+
+if [[ ! -s "$BEST" ]]; then
+  echo "Missing best-validation checkpoint: $BEST" >&2
+  exit 3
+fi
+
+cd "$REPO"
+exec "$PYTHON" -u traineval_h6k16.py \
+  --train-manifest "$MANIFESTS/hot3d_clips_aria_train_h6_k16.jsonl" \
+  --val-manifest "$MANIFESTS/hot3d_clips_aria_validation_h6_k16.jsonl" \
+  --eval-manifest "$MANIFESTS/hot3d_clips_aria_test_h6_k16.jsonl" \
+  --output-dir "$OUTPUT" \
+  --metrics-output "$METRICS" \
+  --resume "$BEST" \
+  --evaluate-only \
+  --eval-timestep-respacing 200 \
+  --num-samples 1 \
+  --sample-gap 1 \
+  --vision-repo /home/jun.se/EGO-HAND-WM-REF/dinov3 \
+  --vision-checkpoint /projects/torresani-lab/sejoon/checkpoints/dinov3/dinov3_vitl16_pretrain_lvd1689m-8aa4cbdd.pth \
+  --batch-size 8 \
+  --workers 8
