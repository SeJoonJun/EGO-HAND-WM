+#!/usr/bin/env bash
+#SBATCH --job-name=hovlm-hot3d-eval
+#SBATCH --account=l.torresani
+#SBATCH --partition=torresani-lab
+#SBATCH --nodes=1
+#SBATCH --ntasks=1
+#SBATCH --cpus-per-task=8
+#SBATCH --mem=192G
+#SBATCH --gres=gpu:h200:1
+#SBATCH --time=08:00:00
+#SBATCH --output=/home/jun.se/EGO-HAND-WM-REF/HandsOnVLM-release/logs/%x-%j.out
+#SBATCH --error=/home/jun.se/EGO-HAND-WM-REF/HandsOnVLM-release/logs/%x-%j.err
+
+set -euo pipefail
+
+REPO=/home/jun.se/EGO-HAND-WM-REF/HandsOnVLM-release
+ENV=/projects/torresani-lab/sejoon/miniconda3/envs/handsonvlm-h6k16
+MANIFEST=/home/jun.se/EGO-HAND-WM/data/hot3d_clips_h6_k16/hot3d_clips_aria_test_h6_k16.jsonl
+CHECKPOINT=/projects/torresani-lab/sejoon/runs/baselines/HandsOnVLM/hot3d-h6k16-absolute-seed0
+OUTPUT=/projects/torresani-lab/sejoon/runs/baselines/HandsOnVLM/hot3d-h6k16-absolute-seed0/test-n1.npz
+
+if [[ ! -s "$CHECKPOINT/config.json" ]]; then
+  echo "Missing promoted best-validation checkpoint: $CHECKPOINT" >&2
+  exit 3
+fi
+
+export PATH="$ENV/bin:$PATH"
+export PYTHONPATH="$REPO${PYTHONPATH:+:$PYTHONPATH}"
+export TRANSFORMERS_OFFLINE=1 HF_HUB_OFFLINE=1 TOKENIZERS_PARALLELISM=false
+
+cd "$REPO"
+exec "$ENV/bin/python" -u handsonvlm/evaluation/evaluate_h6k16.py \
+  --checkpoint "$CHECKPOINT" \
+  --manifest "$MANIFEST" \
+  --output "$OUTPUT" \
+  --batch-size 1 \
+  --workers 4 \
+  --num-samples 1 \
+  --seed 0
