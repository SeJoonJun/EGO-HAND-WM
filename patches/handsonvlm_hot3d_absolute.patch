+def _hot3d_sample(record, *, decode_rgb):
+    sample = canonicalize_hot3d_clip_window(
+        record["tar_path"],
+        record["history_indices"],
+        record["future_indices"],
+        record["history_time_seconds"],
+        record["future_time_seconds"],
+        tracked_hand=record["tracked_hand"],
+        camera_stream=str(record.get("camera_stream", "214-1")),
+        anchor="last_observed",
+        wrist_target="xyz",
+        decode_rgb=decode_rgb,
+        image_size=None,
+        rotate_clockwise=True,
+    )
+    state = torch.cat((sample["history_state"], sample["future_state"]), dim=0)
+    wrist_slice = (
+        SCHEMA.left_wrist
+        if record["tracked_hand"] == "left"
+        else SCHEMA.right_wrist
+    )
+    trajectory = (
+        state[:, wrist_slice.start : wrist_slice.start + 3].cpu().numpy()
+    ).astype(np.float32)
+    frames = None
+    if decode_rgb:
+        frames = [
+            frame.mul(255.0)
+            .round()
+            .clamp(0, 255)
+            .to(torch.uint8)
+            .permute(1, 2, 0)
+            .cpu()
+            .numpy()
+            for frame in sample["context_images"]
+        ]
+    return trajectory, frames
+
